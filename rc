#!/bin/bash

# Configuration
IP="${RC_IPHONE_IP:-iphone.local}"
SOCKET_PATH="/var/mobile/Documents/rc.sock"

# If on device, try to read config for IP if we are default
if [[ "$IP" == "iphone.local" && -f "/var/mobile/Documents/rc_triggers.plist" ]]; then
    # We are on the device, use localhost
    IP="127.0.0.1"
fi

# Fall back to the iPhone static address when the mDNS name does not resolve
if [[ "$IP" == "iphone.local" ]] && ! ping -c 1 -W 300 iphone.local >/dev/null 2>&1; then
    IP="192.168.1.2"
fi

# Parse global options (must come before command)
ROOT_CMD=0
HELP_CMD=0
while [[ "$1" =~ ^- ]]; do
    case "$1" in
        -r|--root)
            ROOT_CMD=1
            shift
            ;;
        -h|--help)
            HELP_CMD=1
            shift
            ;;
        *)
            break
            ;;
    esac
done

# Help comes from the tweak, so there is one command list. It never runs as root.
if [[ "$1" == "help" ]]; then
    ROOT_CMD=0
elif [[ "$HELP_CMD" -eq 1 || "$1" == "-h" || "$1" == "--help" ]]; then
    # `rc -h <word>` searches like `rc help <word>`
    _help_word=""
    if [[ -n "$1" && "$1" != "-h" && "$1" != "--help" ]]; then _help_word="$1"; fi
    set -- help
    if [[ -n "$_help_word" ]]; then set -- help "$_help_word"; fi
    ROOT_CMD=0
fi

if [ -z "$1" ]; then
    echo "Usage: rc [-r|--root] <command> [args]"
    echo ""
    echo "Run 'rc help' for every command, or 'rc help <word>' to search."
    echo ""
    echo "Examples:"
    echo "  rc lock"
    echo "  rc volume 40"
    echo "  rc shortcut \"Good Night\""
    exit 1
fi

# Send one command and print the reply, using the same delivery paths as below
rc_send_command() {
    local command="$1"
    if [[ "$IP" == "127.0.0.1" ]]; then
        # Pass the command as one argument: rc-client then writes it in a single
        # write(), where piping can split a long JSON payload into 1 KB chunks
        # that the device reads and parses before the rest arrives.
        rc-client "$command" 2>/dev/null || printf '%s' "$command" | nc -U "$SOCKET_PATH" 2>/dev/null
    else
        # Buffer the command on the device and pass it to rc-client as one
        # argument, for the same single-write reason as the on-device path.
        printf '%s' "$command" | ssh -o ConnectTimeout=3 -o ServerAliveInterval=2 -o ServerAliveCountMax=2 -o StrictHostKeyChecking=no mobile@$IP 'f=/tmp/rc-cmd.$$; cat > "$f"; if [ -x /var/jb/usr/bin/rc-client ]; then /var/jb/usr/bin/rc-client "$(cat "$f")"; elif [ -x /usr/bin/rc-client ]; then /usr/bin/rc-client "$(cat "$f")"; else nc -U '"$SOCKET_PATH"' < "$f"; fi; rm -f "$f"' 2>/dev/null
    fi
}

rc_expand_path() {
    local p="$1"
    case "$p" in
        "~") printf '%s' "$HOME" ;;
        "~/"*) printf '%s' "$HOME/${p#\~/}" ;;
        *) printf '%s' "$p" ;;
    esac
}

# Refuse writes to an unmounted /Volumes/<name> path so the boot disk isn't filled
rc_check_volume_mount() {
    case "$1" in
        /Volumes/*)
            local vol="/Volumes/$(printf '%s' "$1" | cut -d/ -f3)"
            if ! mount | grep -q " on ${vol} "; then
                echo "Error: ${vol} is not mounted" >&2
                return 1
            fi
            ;;
    esac
    return 0
}

rc_resolve_dest() {
    local raw="$1"
    DEST_DIR=""
    DEST_FILE=""

    if [ -n "$raw" ]; then
        raw="$(rc_expand_path "$raw")"
        rc_check_volume_mount "$raw" || return 1
        if [ -d "$raw" ]; then
            DEST_DIR="${raw%/}"
            [ -n "$DEST_DIR" ] || DEST_DIR="/"
        elif [[ "$raw" == */ ]]; then
            echo "Error: No such directory: $raw" >&2
            return 1
        else
            DEST_DIR="$(dirname "$raw")"
            if [ ! -d "$DEST_DIR" ]; then
                echo "Error: No such directory: $DEST_DIR" >&2
                return 1
            fi
            DEST_FILE="$(basename "$raw")"
        fi
    else
        DEST_DIR="$PWD"
        rc_check_volume_mount "$DEST_DIR" || return 1
    fi

    DEST_DIR="$(cd "$DEST_DIR" && pwd)" || return 1
    if [ -n "$DEST_FILE" ]; then
        DEST_FILE="$DEST_DIR/$DEST_FILE"
    fi
    return 0
}

rc_move_device_file() {
    local remote_path="$1"
    local target="$2"
    local remote_size="$3"

    if [[ "$IP" == "127.0.0.1" ]]; then
        if [ "$remote_path" != "$target" ] && ! mv "$remote_path" "$target"; then
            echo "Error: Could not move $remote_path to $target" >&2
            return 1
        fi
        return 0
    fi

    if ! scp -q -o ConnectTimeout=10 -o StrictHostKeyChecking=no "mobile@$IP:$remote_path" "$target"; then
        echo "Error: Could not copy $remote_path from $IP" >&2
        return 1
    fi
    local local_size
    local_size=$(stat -f %z "$target" 2>/dev/null || wc -c < "$target" 2>/dev/null | tr -d ' ')
    if [ -z "$local_size" ] || [ "$local_size" -le 0 ] 2>/dev/null || [ "$local_size" != "$remote_size" ]; then
        echo "Error: Size mismatch copying $(basename "$remote_path") (local=${local_size:-0}, remote=$remote_size)" >&2
        rm -f "$target"
        return 1
    fi
    if ! ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no mobile@$IP "rm -f '$remote_path'"; then
        echo "Error: Copied to $target, but could not remove $remote_path from $IP" >&2
        return 1
    fi
    return 0
}

# Export: everything Export Configuration writes, one JSON file.
if [[ "$1" == "export" || "$1" == "backup-config" ]]; then
    rc_resolve_dest "${2:-}" || exit 1
    DEFAULT_NAME="rc_export_$(date +%Y%m%d_%H%M).json"
    if [ -n "$DEST_FILE" ]; then
        TARGET="$DEST_FILE"
    else
        TARGET="$DEST_DIR/$DEFAULT_NAME"
    fi

    RESPONSE="$(rc_send_command "backup config")"
    if [ $? -ne 0 ] || [ -z "$RESPONSE" ]; then
        echo "Error: Cannot connect to iPhone at $IP via SSH/Socket." >&2
        exit 1
    fi
    case "$RESPONSE" in
        \{*) ;;
        *) echo "$RESPONSE" >&2; exit 1 ;;
    esac

    if ! (umask 077; printf '%s\n' "$RESPONSE" > "$TARGET"); then
        echo "Error: Could not write $TARGET" >&2
        exit 1
    fi
    chmod 600 "$TARGET" 2>/dev/null || true
    echo "Exported everything to $TARGET"
    exit 0
fi

# Import: copy the file to the device, then apply it there.
if [[ "$1" == "import" || "$1" == "restore" || "$1" == "restore-backup" ]]; then
    IMPORT_FILE="${2:-}"
    if [ -n "$IMPORT_FILE" ]; then
        IMPORT_FILE="$(rc_expand_path "$IMPORT_FILE")"
    fi
    if [ -z "$IMPORT_FILE" ] || [ ! -f "$IMPORT_FILE" ]; then
        echo "Error: Give a file to import: rc import <path>" >&2
        exit 1
    fi

    REMOTE_RESTORE="/var/mobile/Documents/rc_restore.json"
    if [[ "$IP" == "127.0.0.1" ]]; then
        if ! cp "$IMPORT_FILE" "$REMOTE_RESTORE"; then
            echo "Error: Could not write $REMOTE_RESTORE" >&2
            exit 1
        fi
        chmod 600 "$REMOTE_RESTORE" 2>/dev/null || true
    else
        if ! ssh -o ConnectTimeout=3 -o StrictHostKeyChecking=no mobile@$IP "umask 077; cat > $REMOTE_RESTORE" < "$IMPORT_FILE"; then
            echo "Error: Could not copy the file to $IP" >&2
            exit 1
        fi
    fi

    RESPONSE="$(rc_send_command "restore backup")"
    if [ -z "$RESPONSE" ]; then
        echo "Error: Cannot connect to iPhone at $IP via SSH/Socket." >&2
        exit 1
    fi
    echo "$RESPONSE"
    case "$RESPONSE" in
        Error*) exit 1 ;;
    esac
    exit 0
fi

# Backup: run IAmLazy on the device and move the new archive here. The path works
# the same way as export: nothing means the current directory, a directory keeps
# IAmLazy's name for the file, and anything else is the file to write.
if [[ "$1" == "backup" ]]; then
    rc_resolve_dest "${2:-}" || exit 1

    BEFORE="$(rc_send_command "ialazy list" | head -n1 | cut -f1)"
    if [[ "$BEFORE" == Error:* ]]; then
        echo "$BEFORE" >&2
        exit 1
    fi
    if [ -z "$BEFORE" ]; then
        echo "Error: Cannot connect to iPhone at $IP via SSH/Socket." >&2
        exit 1
    fi

    STARTED="$(rc_send_command "ialazy backup")"
    if [ -z "$STARTED" ]; then
        echo "Error: Cannot connect to iPhone at $IP via SSH/Socket." >&2
        exit 1
    fi
    case "$STARTED" in
        Error*) echo "$STARTED" >&2; exit 1 ;;
    esac

    LINE=""
    STABLE=0
    LAST_SIZE=""
    for _ in $(seq 1 200); do
        sleep 3
        CUR_LINE="$(rc_send_command "ialazy list" | head -n1)"
        CUR_NAME="$(printf '%s' "$CUR_LINE" | cut -f1)"
        CUR_SIZE="$(printf '%s' "$CUR_LINE" | cut -f2)"

        HAS_EXIT=0
        if [[ "$IP" == "127.0.0.1" ]]; then
            grep -q '^exit=' /var/mobile/Documents/rc_iamlazy.log 2>/dev/null && HAS_EXIT=1
        else
            ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no mobile@$IP "grep -q '^exit=' /var/mobile/Documents/rc_iamlazy.log 2>/dev/null" && HAS_EXIT=1
        fi

        if [ "$HAS_EXIT" -eq 1 ]; then
            LINE="$(rc_send_command "ialazy list" | head -n1)"
            break
        fi

        if [ -n "$CUR_NAME" ] && [ "$CUR_NAME" != "none" ] && [ "$CUR_NAME" != "$BEFORE" ] && [[ "$CUR_NAME" != Error:* ]]; then
            if [ -n "$CUR_SIZE" ] && [ "$CUR_SIZE" = "$LAST_SIZE" ] && [ "$CUR_SIZE" -gt 0 ] 2>/dev/null; then
                STABLE=$((STABLE + 1))
                if [ "$STABLE" -ge 3 ]; then
                    LINE="$CUR_LINE"
                    break
                fi
            else
                STABLE=1
                LAST_SIZE="$CUR_SIZE"
            fi
        fi
    done

    NAME="$(printf '%s' "$LINE" | cut -f1)"
    if [ -z "$NAME" ] || [ "$NAME" = "none" ] || [ "$NAME" = "$BEFORE" ] || [[ "$NAME" == Error:* ]]; then
        echo "Error: The backup did not finish (no new archive created)" >&2
        if [[ "$IP" == "127.0.0.1" ]]; then
            tail -n 20 /var/mobile/Documents/rc_iamlazy.log 2>/dev/null >&2 || true
        else
            ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no mobile@$IP "tail -n 20 /var/mobile/Documents/rc_iamlazy.log 2>/dev/null" >&2 || true
        fi
        exit 1
    fi

    REMOTE_SIZE="$(printf '%s' "$LINE" | cut -f2)"
    REMOTE_PATH="$(printf '%s' "$LINE" | cut -f4)"
    if [ -z "$REMOTE_PATH" ] || [ -z "$REMOTE_SIZE" ]; then
        echo "Error: The backup folder could not be read on $IP" >&2
        exit 1
    fi

    if [ -n "$DEST_FILE" ]; then
        TARGET="$DEST_FILE"
    else
        TARGET="$DEST_DIR/$NAME"
    fi

    rc_move_device_file "$REMOTE_PATH" "$TARGET" "$REMOTE_SIZE" || exit 1
    chmod 600 "$TARGET" 2>/dev/null || true
    echo "$TARGET"
    exit 0
fi

# Move the newest IAmLazy archive to the Mac and print its path.
if [[ "$1" == "pull-backup" ]]; then
    DEST="$(rc_expand_path "${2:-$HOME/Desktop/RC-Backups/iamlazy}")"
    rc_check_volume_mount "$DEST" || exit 1
    mkdir -p "$DEST" || { echo "Error: Could not create $DEST" >&2; exit 1; }
    DEST="$(cd "$DEST" && pwd)" || exit 1

    REMOTE_DIR=""
    for d in /var/jb/var/mobile/Documents/me.lightmann.iamlazy /var/mobile/Documents/me.lightmann.iamlazy; do
        if [[ "$IP" == "127.0.0.1" ]]; then
            [ -d "$d" ] && REMOTE_DIR="$d" && break
        else
            ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no mobile@$IP "test -d '$d'" 2>/dev/null && REMOTE_DIR="$d" && break
        fi
    done
    if [ -z "$REMOTE_DIR" ]; then
        echo "Error: No IAmLazy backup folder on $IP" >&2
        exit 1
    fi

    if [[ "$IP" == "127.0.0.1" ]]; then
        NEWEST=$(ls -t "$REMOTE_DIR"/*.tar.gz 2>/dev/null | head -n1)
        REMOTE_SIZE=$(wc -c < "$NEWEST" 2>/dev/null | tr -d ' ')
    else
        NEWEST=$(ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no mobile@$IP "ls -t '$REMOTE_DIR'/*.tar.gz 2>/dev/null | head -n1")
        if [ -n "$NEWEST" ]; then
            REMOTE_SIZE=$(ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no mobile@$IP "wc -c < '$NEWEST'" 2>/dev/null | tr -d ' ')
        fi
    fi
    if [ -z "$NEWEST" ]; then
        echo "Error: No backup in $REMOTE_DIR yet" >&2
        exit 1
    fi

    TARGET="$DEST/$(basename "$NEWEST")"
    rc_move_device_file "$NEWEST" "$TARGET" "$REMOTE_SIZE" || exit 1
    chmod 600 "$TARGET" 2>/dev/null || true
    echo "$TARGET"
    exit 0
fi

rc_json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\r'/}"
    s="${s//$'\t'/\\t}"
    s="${s//$'\n'/\\n}"
    printf '"%s"' "$s"
}

rc_quote_arg() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    printf '"%s"' "$s"
}

if [[ "$1" == "timer" ]]; then
    shift 1
    print_timer_help() {
        echo "Usage:"
        echo "  rc timer <duration> [--label \"Name\"]   (e.g. 20m, 1h30m, 45s, 20:00, 1200)"
        echo "  rc timer start <duration> [--label \"Name\"]"
        echo "  rc timer pause"
        echo "  rc timer resume"
        echo "  rc timer stop"
        echo "  rc timer status"
        echo "  (Note: --label naming requires iOS 17+)"
    }

    if [ "$#" -eq 0 ] || [[ "$1" == "--help" || "$1" == "-h" ]]; then
        print_timer_help
        exit 0
    fi

    TIMER_CMD="timer"
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --help|-h)
                print_timer_help
                exit 0
                ;;
            --label=*)
                TIMER_CMD="$TIMER_CMD --label $(rc_quote_arg "${1#--label=}")"
                shift
                ;;
            --title=*)
                TIMER_CMD="$TIMER_CMD --label $(rc_quote_arg "${1#--title=}")"
                shift
                ;;
            *)
                if [[ "$1" == *[[:space:]]* || "$1" == *\"* || "$1" == *\\* || -z "$1" ]]; then
                    TIMER_CMD="$TIMER_CMD $(rc_quote_arg "$1")"
                else
                    TIMER_CMD="$TIMER_CMD $1"
                fi
                shift
                ;;
        esac
    done

    RESPONSE="$(rc_send_command "$TIMER_CMD")"
    if [ $? -ne 0 ] || [ -z "$RESPONSE" ]; then
        echo "Error: Cannot connect to iPhone at $IP via SSH/Socket." >&2
        exit 1
    fi
    echo "$RESPONSE"
    case "$RESPONSE" in Error*) exit 1 ;; esac
    exit 0
fi

# Clear notifications: file paths, inline filter terms, --app, or --all
if [[ "$1" == "clear-notification" || "$1" == "clear-notifications" || ( "$1" == "clear" && ( "$2" == "notification" || "$2" == "notifications" ) ) || ( "$1" == "notify" && "$2" == "clear" ) ]]; then
    IS_LEGACY_NOTIFY_CLEAR=0
    if [[ "$1" == "notify" && "$2" == "clear" ]]; then
        IS_LEGACY_NOTIFY_CLEAR=1
        shift 2
    elif [[ "$1" == "clear" ]]; then
        shift 2
    else
        shift 1
    fi

    print_clear_help() {
        echo "Usage:"
        echo "  rc clear notification --all"
        echo "  rc clear notification /path/to/list.txt"
        echo "  rc clear notification \"Motion Detected\" \"System Monitor\""
        echo "  rc clear notification --app rc \"Test\""
        echo "  rc clear notification --app com.apple.MobileSMS"
        echo "  rc notify clear"
    }

    if [ "$#" -eq 0 ]; then
        if [ "$IS_LEGACY_NOTIFY_CLEAR" -eq 1 ]; then
            RESPONSE="$(rc_send_command "notify clear")"
            if [ $? -ne 0 ] || [ -z "$RESPONSE" ]; then
                echo "Error: Cannot connect to iPhone at $IP via SSH/Socket." >&2
                exit 1
            fi
            echo "$RESPONSE"
            case "$RESPONSE" in Error*) exit 1 ;; esac
            exit 0
        fi
        print_clear_help
        exit 0
    fi

    if [ "$#" -eq 1 ] && [[ "$1" == \{*\} ]]; then
        RESPONSE="$(rc_send_command "notify clear $1")"
        if [ $? -ne 0 ] || [ -z "$RESPONSE" ]; then
            echo "Error: Cannot connect to iPhone at $IP via SSH/Socket." >&2
            exit 1
        fi
        echo "$RESPONSE"
        case "$RESPONSE" in Error*) exit 1 ;; esac
        exit 0
    fi

    CLEAR_APPS=()
    CLEAR_TEXTS=()
    HAD_FILE=0

    append_clear_file_stream() {
        while IFS= read -r line || [ -n "$line" ]; do
            line="${line%$'\r'}"
            local trimmed="${line#"${line%%[![:space:]]*}"}"
            if [ -n "$trimmed" ]; then
                CLEAR_TEXTS+=("$line")
            fi
        done
    }

    append_clear_app() {
        local app="$1"
        local low
        low=$(printf '%s' "$app" | tr '[:upper:]' '[:lower:]')
        if [[ "$low" == "all" || "$low" == "any" || "$low" == "*" ]]; then
            CLEAR_APPS=()
        elif [ -n "$app" ]; then
            CLEAR_APPS+=("$app")
        fi
    }

    expand_clear_path() {
        local p="$1"
        case "$p" in
            "~/"*) printf '%s' "$HOME/${p#\~/}" ;;
            *) printf '%s' "$p" ;;
        esac
    }

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --help|-h)
                print_clear_help
                exit 0
                ;;
            --all|-a)
                CLEAR_APPS=()
                shift
                ;;
            --app|-A)
                if [ -z "${2:-}" ]; then
                    echo "Error: $1 requires an app name or bundle ID" >&2
                    exit 1
                fi
                append_clear_app "$2"
                shift 2
                ;;
            --app=*)
                append_clear_app "${1#--app=}"
                shift
                ;;
            --text|-t)
                if [ "$#" -lt 2 ]; then
                    echo "Error: $1 requires text to match" >&2
                    exit 1
                fi
                if [ -n "$2" ]; then CLEAR_TEXTS+=("$2"); fi
                shift 2
                ;;
            --text=*)
                if [ -n "${1#--text=}" ]; then CLEAR_TEXTS+=("${1#--text=}"); fi
                shift
                ;;
            --file|-f)
                if [ -z "${2:-}" ]; then
                    echo "Error: $1 requires a file path" >&2
                    exit 1
                fi
                HAD_FILE=1
                if [ "$2" = "-" ]; then
                    append_clear_file_stream
                else
                    p="$(expand_clear_path "$2")"
                    if [ ! -f "$p" ]; then
                        echo "Error: File not found: $2" >&2
                        exit 1
                    fi
                    append_clear_file_stream < "$p"
                fi
                shift 2
                ;;
            --file=*)
                HAD_FILE=1
                raw_p="${1#--file=}"
                if [ "$raw_p" = "-" ]; then
                    append_clear_file_stream
                else
                    p="$(expand_clear_path "$raw_p")"
                    if [ ! -f "$p" ]; then
                        echo "Error: File not found: $raw_p" >&2
                        exit 1
                    fi
                    append_clear_file_stream < "$p"
                fi
                shift
                ;;
            -)
                HAD_FILE=1
                append_clear_file_stream
                shift
                ;;
            *)
                p="$(expand_clear_path "$1")"
                if [ -f "$p" ]; then
                    HAD_FILE=1
                    append_clear_file_stream < "$p"
                elif [[ "$p" == *.txt || "$p" == /* || "$p" == ./* || "$p" == ../* ]]; then
                    echo "Error: File not found: $1 (use --text \"$1\" to match literal text)" >&2
                    exit 1
                else
                    CLEAR_TEXTS+=("$1")
                fi
                shift
                ;;
        esac
    done

    if [ "$HAD_FILE" -eq 1 ] && [ "${#CLEAR_TEXTS[@]}" -eq 0 ]; then
        echo "No filters found in file (nothing cleared)."
        exit 0
    fi

    APPS_JSON=""
    if [ "${#CLEAR_APPS[@]}" -gt 0 ]; then
        for a in "${CLEAR_APPS[@]}"; do
            esc="$(rc_json_escape "$a")"
            APPS_JSON="${APPS_JSON:+$APPS_JSON,}$esc"
        done
    fi

    TEXTS_JSON=""
    if [ "${#CLEAR_TEXTS[@]}" -gt 0 ]; then
        for t in "${CLEAR_TEXTS[@]}"; do
            esc="$(rc_json_escape "$t")"
            TEXTS_JSON="${TEXTS_JSON:+$TEXTS_JSON,}$esc"
        done
    fi

    JSON_PARTS=""
    if [ -n "$APPS_JSON" ]; then
        JSON_PARTS="\"apps\":[$APPS_JSON]"
    fi
    if [ -n "$TEXTS_JSON" ]; then
        JSON_PARTS="${JSON_PARTS:+$JSON_PARTS,}\"texts\":[$TEXTS_JSON]"
    fi

    RESPONSE="$(rc_send_command "notify clear {$JSON_PARTS}")"
    if [ $? -ne 0 ] || [ -z "$RESPONSE" ]; then
        echo "Error: Cannot connect to iPhone at $IP via SSH/Socket." >&2
        exit 1
    fi
    echo "$RESPONSE"
    case "$RESPONSE" in Error*) exit 1 ;; esac
    exit 0
fi

# Construct the command string
_CMD=""
if [ "$#" -eq 1 ]; then
    _CMD="$1"
else
    # Correctly handle spaces and arguments
    for arg in "$@"; do
        if [[ "$arg" == *" "* ]]; then
            _CMD="$_CMD \"$arg\""
        else
            _CMD="$_CMD $arg"
        fi
    done
    _CMD=$(echo "$_CMD" | sed 's/^ //')
fi

# Prepend root if requested
if [ "$ROOT_CMD" -eq 1 ]; then
    _CMD="root $_CMD"
fi

# Map user-friendly commands
if [[ "$_CMD" == "vol-up" || "$_CMD" == "volup" ]]; then
    _CMD="button volup"
elif [[ "$_CMD" == "vol-down" || "$_CMD" == "voldown" ]]; then
    _CMD="button voldown"
elif [[ "$_CMD" == "safe-mode" || "$_CMD" == "safe_mode" ]]; then
    _CMD="safemode"
elif [[ "$_CMD" == "shortcut "* ]]; then
    _CMD="shortcut:${_CMD#shortcut }"
elif [[ "$_CMD" == "screen-record"* || "$_CMD" == "screen_record"* ]]; then
    _CMD="screenrecord${_CMD#screen*record}"
elif [[ "$_CMD" == "log" || "$_CMD" == "logs" ]]; then
    if [[ "$IP" == "127.0.0.1" ]]; then
        for log_candidate in "/var/jb/tmp/remotecommand.log" "/tmp/remotecommand.log" "/var/mobile/Library/Logs/RemoteCompanion/remotecompanion.log"; do
            if [ -f "$log_candidate" ]; then
                tail -f "$log_candidate"
                exit 0
            fi
        done
        tail -f /tmp/remotecommand.log
    else
        REMOTE_LOG_CMD="for log_candidate in /var/jb/tmp/remotecommand.log /tmp/remotecommand.log /var/mobile/Library/Logs/RemoteCompanion/remotecompanion.log; do if [ -f \"\$log_candidate\" ]; then tail -f \"\$log_candidate\"; exit 0; fi; done; tail -f /tmp/remotecommand.log"
        ssh -o StrictHostKeyChecking=no mobile@$IP "$REMOTE_LOG_CMD"
    fi
    exit 0
fi

# Command delivery logic (SSH + UNIX Socket)
if [[ "$IP" == "127.0.0.1" ]]; then
    # Local execution (running on device)
    # Try rc-client first (optimized), fallback to nc -U
    RESPONSE=$(echo -n "$_CMD" | rc-client 2>/dev/null || echo -n "$_CMD" | nc -U "$SOCKET_PATH" 2>/dev/null)
else
    # Remote execution via SSH
    # Tunnel to the unix socket on the device
    # We try /var/jb/usr/bin/rc-client (rootless) then rootful path, then nc -U as final fallback
    REMOTE_CMD="echo -n '$_CMD' | /var/jb/usr/bin/rc-client 2>/dev/null || echo -n '$_CMD' | /usr/bin/rc-client 2>/dev/null || echo -n '$_CMD' | nc -U $SOCKET_PATH 2>/dev/null"
    RESPONSE=$(ssh -o ConnectTimeout=3 -o ServerAliveInterval=2 -o ServerAliveCountMax=2 -o StrictHostKeyChecking=no mobile@$IP "$REMOTE_CMD" 2>/dev/null)
fi

# Output handling
if [ $? -eq 0 ]; then
    if [ ! -z "$RESPONSE" ]; then
        echo "$RESPONSE"
    elif [[ "$_CMD" == "help" || "$_CMD" == help\ * ]]; then
        echo "No help was returned. Is the RemoteCompanion tweak loaded on the device?" >&2
    fi
    exit 0
else
    echo "Error: Cannot connect to iPhone at $IP via SSH/Socket." >&2
    exit 1
fi
