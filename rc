#!/bin/bash

# Configuration
IP="${RC_IPHONE_IP:-iphone.local}"
SOCKET_PATH="/var/mobile/Documents/rc.sock"

# If on device, try to read config for IP if we are default
if [[ "$IP" == "iphone.local" && -f "/var/mobile/Documents/rc_triggers.plist" ]]; then
    # We are on the device, use localhost
    IP="127.0.0.1"
fi

# Parse global options (must come before command)
ROOT_CMD=0
while [[ "$1" =~ ^- ]]; do
    case "$1" in
        -r|--root)
            ROOT_CMD=1
            shift
            ;;
        *)
            break
            ;;
    esac
done

if [ -z "$1" ]; then
    echo "Usage: rc [-r] <command> [arg]"
    echo ""
    echo "Implemented Commands:"
    echo "  -r, --root        - Run command as root"
    echo "  play, pause       - Media Control"
    echo "  vol-up, vol-down  - Volume Control"
    echo "  set-vol <0-100>   - Set Volume"
    echo "  shortcut \"Name\"   - Run a Shortcut"
    echo "  ping              - Play Alert Sound"
    echo "  respring          - Restart SpringBoard"
    echo "  safemode          - Enter Safe Mode"
    echo "  bt on/off         - Turn Bluetooth On/Off"
    echo "  wifi on/off       - Turn WiFi On/Off"
    echo "  cellular on/off/toggle - Turn Cellular Data On/Off/Toggle"
    echo "  location on/off/toggle - Turn Location Services (GPS) On/Off/Toggle"
    echo "  airplane on/off   - Turn Airplane Mode On/Off"
    echo "  brightness <0-100> - Set screen brightness"
    echo "  haptic            - Trigger haptic tap"
    echo "  tap <x> <y>       - Tap screen coordinates"
    echo "  taprecord         - Record a screen tap location after 3s delay"
    echo "  flash on/off      - Turn flashlight on/off"
    echo "  rotate lock/unlock - Toggle orientation lock"
    echo "  appearance dark/light/toggle - Set device appearance"
    echo "  lock              - Lock the device screen"
    echo "  unlock [pin]      - Unlock the device screen"
    echo "  lock-toggle [pin] - Toggle device lock/unlock state"
    echo "  is-locked         - Check if device is locked"
    echo "  autolock [30s|1m-5m|never|off|toggle|status] - Configure auto-lock timeout"
    echo "  display sleep [30s|1m-5m|never|off] - Change when display goes to sleep"
    echo "  dnd on/off/debug   - Toggle Do Not Disturb or inspect state"
    echo "  audiomix on/off/toggle/status - Control AudioMix tweak"
    echo "  screenrecord [toggle|start|stop] - Control system screen recording"
    echo "  snapper [open|freeze|instant|close|last|history] - Control Snapper 2 / Snapper 3"
    echo "  sneakycam photo/video - Trigger SneakyCam photo or toggle video"
    echo "  camera [photo|video|portrait|slomo|timelapse] [0.5x|1x|2x] [front] [flash] - Open Camera in specified mode"
    echo "  camera shutter / snap - Press Camera shutter button to take photo or toggle recording"
    echo "  camera record     - Toggle video recording in Camera app"
    echo "  toast \"Title\" [\"Subtitle\"] [\"Icon\"] - Display HUD toast notification"
    echo "  notify \"Title\" [\"Message\"] [--urgent] [--remove-after SECONDS] [--image \"sf:NAME\"|\"app:BUNDLE\"] [--image-url URL] - Post a standard iOS notification"
    echo "         --image sets its icon; --image-url attaches a photo from the web; --tap ID runs notiftap_ID on a tap"
    echo "         --button \"ID|Title|flags\" adds a button; --wait SECONDS waits for the answer"
    echo "  notify clear - Remove RC's notifications from Notification Center"
    echo "  clear notification [--all] [--app BUNDLE|rc] [--text TEXT] [FILE.txt|TEXT...]"
    echo "         Clear notifications by app and/or matching text (or a line-by-line .txt file)"
    echo "  ha <toggle|turn_on|turn_off|call> - Control Home Assistant"
    echo "  km <trigger|url>  - Trigger Keyboard Maestro Macro or URL"
    echo "  mqtt <pub|publish> <topic> [payload] - Publish MQTT topic"
    echo "  http-request <json|url> - Call a REST API with method, headers and body"
    echo "  blacklist <list|add|remove|reset> - Manage app exclusion"
    echo "  nav <panel>       - Navigate companion app (triggers, settings, ha, km, mqtt, add)"
    echo "  backup [path]     - Save everything for an exact restore (default: current directory; a directory or file)"
    echo "  restore <path>    - Restore a backup file on the device"
    echo "  log               - Stream device logs"
    echo ""
    exit 1
fi

# Send one command and print the reply, using the same delivery paths as below
rc_send_command() {
    local command="$1"
    if [[ "$IP" == "127.0.0.1" ]]; then
        printf '%s' "$command" | rc-client 2>/dev/null || printf '%s' "$command" | nc -U "$SOCKET_PATH" 2>/dev/null
    else
        printf '%s' "$command" | ssh -o ConnectTimeout=3 -o ServerAliveInterval=2 -o ServerAliveCountMax=2 -o StrictHostKeyChecking=no mobile@$IP 'if [ -x /var/jb/usr/bin/rc-client ]; then /var/jb/usr/bin/rc-client; elif [ -x /usr/bin/rc-client ]; then /usr/bin/rc-client; else nc -U '"$SOCKET_PATH"'; fi' 2>/dev/null
    fi
}

# Full backup: everything Export Configuration writes, one JSON file.
if [[ "$1" == "backup" || "$1" == "backup-config" ]]; then
    BACKUP_ARG="${2:-}"
    DEFAULT_NAME="rc_backup_$(date +%Y%m%d_%H%M).json"

    if [ -z "$BACKUP_ARG" ]; then
        TARGET="$PWD/$DEFAULT_NAME"
    else
        case "$BACKUP_ARG" in
            "~") BACKUP_ARG="$HOME" ;;
            "~/"*) BACKUP_ARG="$HOME/${BACKUP_ARG#\~/}" ;;
        esac
        if [ -d "$BACKUP_ARG" ]; then
            TARGET="${BACKUP_ARG%/}/$DEFAULT_NAME"
        elif [[ "$BACKUP_ARG" == */ ]]; then
            echo "Error: No such directory: $BACKUP_ARG" >&2
            exit 1
        else
            TARGET="$BACKUP_ARG"
        fi
    fi

    TARGET_DIR="$(dirname "$TARGET")"
    if [ ! -d "$TARGET_DIR" ]; then
        echo "Error: No such directory: $TARGET_DIR" >&2
        exit 1
    fi
    TARGET="$(cd "$TARGET_DIR" && pwd)/$(basename "$TARGET")"

    RESPONSE="$(rc_send_command "backup config")"
    if [ $? -ne 0 ] || [ -z "$RESPONSE" ]; then
        echo "Error: Cannot connect to iPhone at $IP via SSH/Socket." >&2
        exit 1
    fi
    case "$RESPONSE" in
        \{*) ;;
        *) echo "$RESPONSE" >&2; exit 1 ;;
    esac

    if ! (umask 077; printf '%s\n' "$RESPONSE" > "$TARGET"); then
        echo "Error: Could not write $TARGET" >&2
        exit 1
    fi
    chmod 600 "$TARGET" 2>/dev/null || true
    echo "Backed up everything to $TARGET"
    exit 0
fi

# Restore: copy the file to the device, then apply it there.
if [[ "$1" == "restore" || "$1" == "restore-backup" ]]; then
    RESTORE_FILE="${2:-}"
    if [ -z "$RESTORE_FILE" ] || [ ! -f "$RESTORE_FILE" ]; then
        echo "Error: Give a backup file: rc restore <path>" >&2
        exit 1
    fi

    REMOTE_RESTORE="/var/mobile/Documents/rc_restore.json"
    if [[ "$IP" == "127.0.0.1" ]]; then
        if ! cp "$RESTORE_FILE" "$REMOTE_RESTORE"; then
            echo "Error: Could not write $REMOTE_RESTORE" >&2
            exit 1
        fi
        chmod 600 "$REMOTE_RESTORE" 2>/dev/null || true
    else
        if ! ssh -o ConnectTimeout=3 -o StrictHostKeyChecking=no mobile@$IP "umask 077; cat > $REMOTE_RESTORE" < "$RESTORE_FILE"; then
            echo "Error: Could not copy the backup to $IP" >&2
            exit 1
        fi
    fi

    RESPONSE="$(rc_send_command "restore backup")"
    if [ -z "$RESPONSE" ]; then
        echo "Error: Cannot connect to iPhone at $IP via SSH/Socket." >&2
        exit 1
    fi
    echo "$RESPONSE"
    case "$RESPONSE" in
        Error*) exit 1 ;;
    esac
    exit 0
fi

rc_json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\r'/}"
    s="${s//$'\t'/\\t}"
    s="${s//$'\n'/\\n}"
    printf '"%s"' "$s"
}

# Clear notifications: file paths, inline filter terms, --app, or --all
if [[ "$1" == "clear-notification" || "$1" == "clear-notifications" || ( "$1" == "clear" && ( "$2" == "notification" || "$2" == "notifications" ) ) || ( "$1" == "notify" && "$2" == "clear" ) ]]; then
    IS_LEGACY_NOTIFY_CLEAR=0
    if [[ "$1" == "notify" && "$2" == "clear" ]]; then
        IS_LEGACY_NOTIFY_CLEAR=1
        shift 2
    elif [[ "$1" == "clear" ]]; then
        shift 2
    else
        shift 1
    fi

    print_clear_help() {
        echo "Usage:"
        echo "  rc clear notification --all"
        echo "  rc clear notification /path/to/list.txt"
        echo "  rc clear notification \"Motion Detected\" \"System Monitor\""
        echo "  rc clear notification --app rc \"Test\""
        echo "  rc clear notification --app com.apple.MobileSMS"
        echo "  rc notify clear"
    }

    if [ "$#" -eq 0 ]; then
        if [ "$IS_LEGACY_NOTIFY_CLEAR" -eq 1 ]; then
            RESPONSE="$(rc_send_command "notify clear")"
            if [ $? -ne 0 ] || [ -z "$RESPONSE" ]; then
                echo "Error: Cannot connect to iPhone at $IP via SSH/Socket." >&2
                exit 1
            fi
            echo "$RESPONSE"
            case "$RESPONSE" in Error*) exit 1 ;; esac
            exit 0
        fi
        print_clear_help
        exit 0
    fi

    if [ "$#" -eq 1 ] && [[ "$1" == \{*\} ]]; then
        RESPONSE="$(rc_send_command "notify clear $1")"
        if [ $? -ne 0 ] || [ -z "$RESPONSE" ]; then
            echo "Error: Cannot connect to iPhone at $IP via SSH/Socket." >&2
            exit 1
        fi
        echo "$RESPONSE"
        case "$RESPONSE" in Error*) exit 1 ;; esac
        exit 0
    fi

    CLEAR_APPS=()
    CLEAR_TEXTS=()
    HAD_FILE=0

    append_clear_file_stream() {
        while IFS= read -r line || [ -n "$line" ]; do
            line="${line%$'\r'}"
            local trimmed="${line#"${line%%[![:space:]]*}"}"
            if [ -n "$trimmed" ]; then
                CLEAR_TEXTS+=("$line")
            fi
        done
    }

    append_clear_app() {
        local app="$1"
        local low
        low=$(printf '%s' "$app" | tr '[:upper:]' '[:lower:]')
        if [[ "$low" == "all" || "$low" == "any" || "$low" == "*" ]]; then
            CLEAR_APPS=()
        elif [ -n "$app" ]; then
            CLEAR_APPS+=("$app")
        fi
    }

    expand_clear_path() {
        local p="$1"
        case "$p" in
            "~/"*) printf '%s' "$HOME/${p#\~/}" ;;
            *) printf '%s' "$p" ;;
        esac
    }

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --help|-h)
                print_clear_help
                exit 0
                ;;
            --all|-a)
                CLEAR_APPS=()
                shift
                ;;
            --app|-A)
                if [ -z "${2:-}" ]; then
                    echo "Error: $1 requires an app name or bundle ID" >&2
                    exit 1
                fi
                append_clear_app "$2"
                shift 2
                ;;
            --app=*)
                append_clear_app "${1#--app=}"
                shift
                ;;
            --text|-t)
                if [ "$#" -lt 2 ]; then
                    echo "Error: $1 requires text to match" >&2
                    exit 1
                fi
                if [ -n "$2" ]; then CLEAR_TEXTS+=("$2"); fi
                shift 2
                ;;
            --text=*)
                if [ -n "${1#--text=}" ]; then CLEAR_TEXTS+=("${1#--text=}"); fi
                shift
                ;;
            --file|-f)
                if [ -z "${2:-}" ]; then
                    echo "Error: $1 requires a file path" >&2
                    exit 1
                fi
                HAD_FILE=1
                if [ "$2" = "-" ]; then
                    append_clear_file_stream
                else
                    p="$(expand_clear_path "$2")"
                    if [ ! -f "$p" ]; then
                        echo "Error: File not found: $2" >&2
                        exit 1
                    fi
                    append_clear_file_stream < "$p"
                fi
                shift 2
                ;;
            --file=*)
                HAD_FILE=1
                raw_p="${1#--file=}"
                if [ "$raw_p" = "-" ]; then
                    append_clear_file_stream
                else
                    p="$(expand_clear_path "$raw_p")"
                    if [ ! -f "$p" ]; then
                        echo "Error: File not found: $raw_p" >&2
                        exit 1
                    fi
                    append_clear_file_stream < "$p"
                fi
                shift
                ;;
            -)
                HAD_FILE=1
                append_clear_file_stream
                shift
                ;;
            *)
                p="$(expand_clear_path "$1")"
                if [ -f "$p" ]; then
                    HAD_FILE=1
                    append_clear_file_stream < "$p"
                elif [[ "$p" == *.txt || "$p" == /* || "$p" == ./* || "$p" == ../* ]]; then
                    echo "Error: File not found: $1 (use --text \"$1\" to match literal text)" >&2
                    exit 1
                else
                    CLEAR_TEXTS+=("$1")
                fi
                shift
                ;;
        esac
    done

    if [ "$HAD_FILE" -eq 1 ] && [ "${#CLEAR_TEXTS[@]}" -eq 0 ]; then
        echo "No filters found in file (nothing cleared)."
        exit 0
    fi

    APPS_JSON=""
    if [ "${#CLEAR_APPS[@]}" -gt 0 ]; then
        for a in "${CLEAR_APPS[@]}"; do
            esc="$(rc_json_escape "$a")"
            APPS_JSON="${APPS_JSON:+$APPS_JSON,}$esc"
        done
    fi

    TEXTS_JSON=""
    if [ "${#CLEAR_TEXTS[@]}" -gt 0 ]; then
        for t in "${CLEAR_TEXTS[@]}"; do
            esc="$(rc_json_escape "$t")"
            TEXTS_JSON="${TEXTS_JSON:+$TEXTS_JSON,}$esc"
        done
    fi

    JSON_PARTS=""
    if [ -n "$APPS_JSON" ]; then
        JSON_PARTS="\"apps\":[$APPS_JSON]"
    fi
    if [ -n "$TEXTS_JSON" ]; then
        JSON_PARTS="${JSON_PARTS:+$JSON_PARTS,}\"texts\":[$TEXTS_JSON]"
    fi

    RESPONSE="$(rc_send_command "notify clear {$JSON_PARTS}")"
    if [ $? -ne 0 ] || [ -z "$RESPONSE" ]; then
        echo "Error: Cannot connect to iPhone at $IP via SSH/Socket." >&2
        exit 1
    fi
    echo "$RESPONSE"
    case "$RESPONSE" in Error*) exit 1 ;; esac
    exit 0
fi

# Construct the command string
_CMD=""
if [ "$#" -eq 1 ]; then
    _CMD="$1"
else
    # Correctly handle spaces and arguments
    for arg in "$@"; do
        if [[ "$arg" == *" "* ]]; then
            _CMD="$_CMD \"$arg\""
        else
            _CMD="$_CMD $arg"
        fi
    done
    _CMD=$(echo "$_CMD" | sed 's/^ //')
fi

# Prepend root if requested
if [ "$ROOT_CMD" -eq 1 ]; then
    _CMD="root $_CMD"
fi

# Map user-friendly commands
if [[ "$_CMD" == "vol-up" || "$_CMD" == "volup" ]]; then
    _CMD="button volup"
elif [[ "$_CMD" == "vol-down" || "$_CMD" == "voldown" ]]; then
    _CMD="button voldown"
elif [[ "$_CMD" == "safe-mode" || "$_CMD" == "safe_mode" ]]; then
    _CMD="safemode"
elif [[ "$_CMD" == "shortcut "* ]]; then
    _CMD="shortcut:${_CMD#shortcut }"
elif [[ "$_CMD" == "screen-record"* || "$_CMD" == "screen_record"* ]]; then
    _CMD="screenrecord${_CMD#screen*record}"
elif [[ "$_CMD" == "log" || "$_CMD" == "logs" ]]; then
    if [[ "$IP" == "127.0.0.1" ]]; then
        for log_candidate in "/var/jb/tmp/remotecommand.log" "/tmp/remotecommand.log" "/var/mobile/Library/Logs/RemoteCompanion/remotecompanion.log"; do
            if [ -f "$log_candidate" ]; then
                tail -f "$log_candidate"
                exit 0
            fi
        done
        tail -f /tmp/remotecommand.log
    else
        REMOTE_LOG_CMD="for log_candidate in /var/jb/tmp/remotecommand.log /tmp/remotecommand.log /var/mobile/Library/Logs/RemoteCompanion/remotecompanion.log; do if [ -f \"\$log_candidate\" ]; then tail -f \"\$log_candidate\"; exit 0; fi; done; tail -f /tmp/remotecommand.log"
        ssh -o StrictHostKeyChecking=no mobile@$IP "$REMOTE_LOG_CMD"
    fi
    exit 0
fi

# Command delivery logic (SSH + UNIX Socket)
if [[ "$IP" == "127.0.0.1" ]]; then
    # Local execution (running on device)
    # Try rc-client first (optimized), fallback to nc -U
    RESPONSE=$(echo -n "$_CMD" | rc-client 2>/dev/null || echo -n "$_CMD" | nc -U "$SOCKET_PATH" 2>/dev/null)
else
    # Remote execution via SSH
    # Tunnel to the unix socket on the device
    # We try /var/jb/usr/bin/rc-client (rootless) then rootful path, then nc -U as final fallback
    REMOTE_CMD="echo -n '$_CMD' | /var/jb/usr/bin/rc-client 2>/dev/null || echo -n '$_CMD' | /usr/bin/rc-client 2>/dev/null || echo -n '$_CMD' | nc -U $SOCKET_PATH 2>/dev/null"
    RESPONSE=$(ssh -o ConnectTimeout=3 -o ServerAliveInterval=2 -o ServerAliveCountMax=2 -o StrictHostKeyChecking=no mobile@$IP "$REMOTE_CMD" 2>/dev/null)
fi

# Output handling
if [ $? -eq 0 ]; then
    if [ ! -z "$RESPONSE" ]; then
        echo "$RESPONSE"
    fi
    exit 0
else
    echo "Error: Cannot connect to iPhone at $IP via SSH/Socket." >&2
    exit 1
fi
