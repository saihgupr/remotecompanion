#!/bin/bash

# Configuration
IP="${RC_IPHONE_IP:-iphone.local}"
SOCKET_PATH="/var/mobile/Documents/rc.sock"

# If on device, try to read config for IP if we are default
if [[ "$IP" == "iphone.local" && -f "/var/mobile/Documents/rc_triggers.plist" ]]; then
    # We are on the device, use localhost
    IP="127.0.0.1"
fi

# Parse global options (must come before command)
ROOT_CMD=0
while [[ "$1" =~ ^- ]]; do
    case "$1" in
        -r|--root)
            ROOT_CMD=1
            shift
            ;;
        *)
            break
            ;;
    esac
done

if [ -z "$1" ]; then
    echo "Usage: rc [-r] <command> [arg]"
    echo ""
    echo "Implemented Commands:"
    echo "  -r, --root        - Run command as root"
    echo "  play, pause       - Media Control"
    echo "  vol-up, vol-down  - Volume Control"
    echo "  set-vol <0-100>   - Set Volume"
    echo "  shortcut \"Name\"   - Run a Shortcut"
    echo "  ping              - Play Alert Sound"
    echo "  respring          - Restart SpringBoard"
    echo "  safemode          - Enter Safe Mode"
    echo "  bt on/off         - Turn Bluetooth On/Off"
    echo "  wifi on/off       - Turn WiFi On/Off"
    echo "  cellular on/off/toggle - Turn Cellular Data On/Off/Toggle"
    echo "  location on/off/toggle - Turn Location Services (GPS) On/Off/Toggle"
    echo "  airplane on/off   - Turn Airplane Mode On/Off"
    echo "  brightness <0-100> - Set screen brightness"
    echo "  haptic            - Trigger haptic tap"
    echo "  tap <x> <y>       - Tap screen coordinates using beta backend"
    echo "  taptest run       - Show test target, tap it, and report PASS/FAIL"
    echo "  taprecord         - Record a screen tap location after 3s delay"
    echo "  flash on/off      - Turn flashlight on/off"
    echo "  rotate lock/unlock - Toggle orientation lock"
    echo "  appearance dark/light/toggle - Set device appearance"
    echo "  lock              - Lock the device screen"
    echo "  unlock [pin]      - Unlock the device screen"
    echo "  lock-toggle [pin] - Toggle device lock/unlock state"
    echo "  is-locked         - Check if device is locked"
    echo "  autolock [30s|1m-5m|never|off|toggle|status] - Configure auto-lock timeout"
    echo "  display sleep [30s|1m-5m|never|off] - Change when display goes to sleep"
    echo "  dnd on/off/debug   - Toggle Do Not Disturb or inspect state"
    echo "  audiomix on/off/toggle/status - Control AudioMix tweak"
    echo "  screenrecord [toggle|start|stop] - Control system screen recording"
    echo "  snapper [open|freeze|instant|close|last|history] - Control Snapper 2 / Snapper 3"
    echo "  sneakycam photo/video - Trigger SneakyCam photo or toggle video"
    echo "  camera [photo|video|portrait|slomo|timelapse] [0.5x|1x|2x] [front] [flash] - Open Camera in specified mode"
    echo "  camera shutter / snap - Press Camera shutter button to take photo or toggle recording"
    echo "  camera record     - Toggle video recording in Camera app"
    echo "  toast \"Title\" [\"Subtitle\"] [\"Icon\"] - Display HUD toast notification"
    echo "  ha <toggle|turn_on|turn_off|call> - Control Home Assistant"
    echo "  km <trigger|url>  - Trigger Keyboard Maestro Macro or URL"
    echo "  mqtt <pub|publish> <topic> [payload] - Publish MQTT topic"
    echo "  http-request <json|url> - Call a REST API with method, headers and body"
    echo "  blacklist <list|add|remove|reset> - Manage app exclusion"
    echo "  nav <panel>       - Navigate companion app (triggers, settings, ha, km, mqtt, add)"
    echo "  export [path]     - Save everything for an exact restore (default: current directory; a directory or file)"
    echo "  import <path>     - Restore an exported file on the device"
    echo "  pull-backup [dir] - Copy the newest IAmLazy backup to the Mac, printing its path"
    echo "  log               - Stream device logs"
    echo ""
    exit 1
fi

# Send one command and print the reply, using the same delivery paths as below
rc_send_command() {
    local command="$1"
    if [[ "$IP" == "127.0.0.1" ]]; then
        echo -n "$command" | rc-client 2>/dev/null || echo -n "$command" | nc -U "$SOCKET_PATH" 2>/dev/null
    else
        local remote_cmd="echo -n '$command' | /var/jb/usr/bin/rc-client 2>/dev/null || echo -n '$command' | /usr/bin/rc-client 2>/dev/null || echo -n '$command' | nc -U $SOCKET_PATH 2>/dev/null"
        ssh -o ConnectTimeout=3 -o ServerAliveInterval=2 -o ServerAliveCountMax=2 -o StrictHostKeyChecking=no mobile@$IP "$remote_cmd" 2>/dev/null
    fi
}

# Export: everything Export Configuration writes, one JSON file.
if [[ "$1" == "export" ]]; then
    EXPORT_ARG="${2:-}"
    DEFAULT_NAME="rc_export_$(date +%Y%m%d_%H%M).json"

    if [ -z "$EXPORT_ARG" ]; then
        TARGET="$PWD/$DEFAULT_NAME"
    else
        case "$EXPORT_ARG" in
            "~") EXPORT_ARG="$HOME" ;;
            "~/"*) EXPORT_ARG="$HOME/${EXPORT_ARG#\~/}" ;;
        esac
        if [ -d "$EXPORT_ARG" ]; then
            TARGET="${EXPORT_ARG%/}/$DEFAULT_NAME"
        elif [[ "$EXPORT_ARG" == */ ]]; then
            echo "Error: No such directory: $EXPORT_ARG" >&2
            exit 1
        else
            TARGET="$EXPORT_ARG"
        fi
    fi

    TARGET_DIR="$(dirname "$TARGET")"
    if [ ! -d "$TARGET_DIR" ]; then
        echo "Error: No such directory: $TARGET_DIR" >&2
        exit 1
    fi
    TARGET="$(cd "$TARGET_DIR" && pwd)/$(basename "$TARGET")"

    RESPONSE="$(rc_send_command "backup config")"
    if [ $? -ne 0 ] || [ -z "$RESPONSE" ]; then
        echo "Error: Cannot connect to iPhone at $IP via SSH/Socket." >&2
        exit 1
    fi
    case "$RESPONSE" in
        \{*) ;;
        *) echo "$RESPONSE" >&2; exit 1 ;;
    esac

    if ! (umask 077; printf '%s\n' "$RESPONSE" > "$TARGET"); then
        echo "Error: Could not write $TARGET" >&2
        exit 1
    fi
    chmod 600 "$TARGET" 2>/dev/null || true
    echo "Exported everything to $TARGET"
    exit 0
fi

# Import: copy the file to the device, then apply it there.
if [[ "$1" == "import" ]]; then
    IMPORT_FILE="${2:-}"
    if [ -z "$IMPORT_FILE" ] || [ ! -f "$IMPORT_FILE" ]; then
        echo "Error: Give a file to import: rc import <path>" >&2
        exit 1
    fi

    REMOTE_RESTORE="/var/mobile/Documents/rc_restore.json"
    if [[ "$IP" == "127.0.0.1" ]]; then
        if ! cp "$IMPORT_FILE" "$REMOTE_RESTORE"; then
            echo "Error: Could not write $REMOTE_RESTORE" >&2
            exit 1
        fi
        chmod 600 "$REMOTE_RESTORE" 2>/dev/null || true
    else
        if ! ssh -o ConnectTimeout=3 -o StrictHostKeyChecking=no mobile@$IP "umask 077; cat > $REMOTE_RESTORE" < "$IMPORT_FILE"; then
            echo "Error: Could not copy the file to $IP" >&2
            exit 1
        fi
    fi

    RESPONSE="$(rc_send_command "restore backup")"
    if [ -z "$RESPONSE" ]; then
        echo "Error: Cannot connect to iPhone at $IP via SSH/Socket." >&2
        exit 1
    fi
    echo "$RESPONSE"
    case "$RESPONSE" in
        Error*) exit 1 ;;
    esac
    exit 0
fi

# Pull the newest IAmLazy archive to the Mac. The backup itself is made in the app; this only
# copies it, so it prints the saved path and nothing else on success.
if [[ "$1" == "pull-backup" ]]; then
    DEST="${2:-$HOME/Desktop/RC-Backups/iamlazy}"
    case "$DEST" in
        "~") DEST="$HOME" ;;
        "~/"*) DEST="$HOME/${DEST#\~/}" ;;
    esac
    # A path under an unmounted drive would otherwise be created on the boot disk and filled
    case "$DEST" in
        /Volumes/*)
            VOL="/Volumes/$(printf '%s' "$DEST" | cut -d/ -f3)"
            if ! mount | grep -q " on ${VOL} "; then
                echo "Error: ${VOL} is not mounted" >&2
                exit 1
            fi
            ;;
    esac
    mkdir -p "$DEST" || { echo "Error: Could not create $DEST" >&2; exit 1; }

    REMOTE_DIR=""
    for d in /var/jb/var/mobile/Documents/me.lightmann.iamlazy /var/mobile/Documents/me.lightmann.iamlazy; do
        if [[ "$IP" == "127.0.0.1" ]]; then
            [ -d "$d" ] && REMOTE_DIR="$d" && break
        else
            ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no mobile@$IP "test -d '$d'" 2>/dev/null && REMOTE_DIR="$d" && break
        fi
    done
    if [ -z "$REMOTE_DIR" ]; then
        echo "Error: No IAmLazy backup folder on $IP" >&2
        exit 1
    fi

    if [[ "$IP" == "127.0.0.1" ]]; then
        NEWEST=$(ls -t "$REMOTE_DIR"/*.tar.gz 2>/dev/null | head -n1)
    else
        NEWEST=$(ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no mobile@$IP "ls -t '$REMOTE_DIR'/*.tar.gz 2>/dev/null | head -n1")
    fi
    if [ -z "$NEWEST" ]; then
        echo "Error: No backup in $REMOTE_DIR yet" >&2
        exit 1
    fi

    NAME="$(basename "$NEWEST")"
    TARGET="$DEST/$NAME"
    if [[ "$IP" == "127.0.0.1" ]]; then
        [ "$NEWEST" = "$TARGET" ] || cp "$NEWEST" "$TARGET" || exit 1
    else
        REMOTE_SIZE=$(ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no mobile@$IP "wc -c < '$NEWEST'" 2>/dev/null | tr -d ' ')
        LOCAL_SIZE=$(stat -f %z "$TARGET" 2>/dev/null)
        if [ -z "$REMOTE_SIZE" ] || [ "$REMOTE_SIZE" != "$LOCAL_SIZE" ]; then
            scp -q -o ConnectTimeout=10 -o StrictHostKeyChecking=no "mobile@$IP:$NEWEST" "$TARGET" || {
                echo "Error: Could not copy $NEWEST from $IP" >&2
                exit 1
            }
        fi
    fi
    chmod 600 "$TARGET" 2>/dev/null || true
    echo "$TARGET"
    exit 0
fi

# Construct the command string
_CMD=""
if [ "$#" -eq 1 ]; then
    _CMD="$1"
else
    # Correctly handle spaces and arguments
    for arg in "$@"; do
        if [[ "$arg" == *" "* ]]; then
            _CMD="$_CMD \"$arg\""
        else
            _CMD="$_CMD $arg"
        fi
    done
    _CMD=$(echo "$_CMD" | sed 's/^ //')
fi

# Prepend root if requested
if [ "$ROOT_CMD" -eq 1 ]; then
    _CMD="root $_CMD"
fi

# Map user-friendly commands
if [[ "$_CMD" == "vol-up" || "$_CMD" == "volup" ]]; then
    _CMD="button volup"
elif [[ "$_CMD" == "vol-down" || "$_CMD" == "voldown" ]]; then
    _CMD="button voldown"
elif [[ "$_CMD" == "safe-mode" || "$_CMD" == "safe_mode" ]]; then
    _CMD="safemode"
elif [[ "$_CMD" == "shortcut "* ]]; then
    _CMD="shortcut:${_CMD#shortcut }"
elif [[ "$_CMD" == "screen-record"* || "$_CMD" == "screen_record"* ]]; then
    _CMD="screenrecord${_CMD#screen*record}"
elif [[ "$_CMD" == "log" || "$_CMD" == "logs" ]]; then
    if [[ "$IP" == "127.0.0.1" ]]; then
        for log_candidate in "/var/jb/tmp/remotecommand.log" "/tmp/remotecommand.log" "/var/mobile/Library/Logs/RemoteCompanion/remotecompanion.log"; do
            if [ -f "$log_candidate" ]; then
                tail -f "$log_candidate"
                exit 0
            fi
        done
        tail -f /tmp/remotecommand.log
    else
        REMOTE_LOG_CMD="for log_candidate in /var/jb/tmp/remotecommand.log /tmp/remotecommand.log /var/mobile/Library/Logs/RemoteCompanion/remotecompanion.log; do if [ -f \"\$log_candidate\" ]; then tail -f \"\$log_candidate\"; exit 0; fi; done; tail -f /tmp/remotecommand.log"
        ssh -o StrictHostKeyChecking=no mobile@$IP "$REMOTE_LOG_CMD"
    fi
    exit 0
fi

# Command delivery logic (SSH + UNIX Socket)
if [[ "$IP" == "127.0.0.1" ]]; then
    # Local execution (running on device)
    # Try rc-client first (optimized), fallback to nc -U
    RESPONSE=$(echo -n "$_CMD" | rc-client 2>/dev/null || echo -n "$_CMD" | nc -U "$SOCKET_PATH" 2>/dev/null)
else
    # Remote execution via SSH
    # Tunnel to the unix socket on the device
    # We try /var/jb/usr/bin/rc-client (rootless) then rootful path, then nc -U as final fallback
    REMOTE_CMD="echo -n '$_CMD' | /var/jb/usr/bin/rc-client 2>/dev/null || echo -n '$_CMD' | /usr/bin/rc-client 2>/dev/null || echo -n '$_CMD' | nc -U $SOCKET_PATH 2>/dev/null"
    RESPONSE=$(ssh -o ConnectTimeout=3 -o ServerAliveInterval=2 -o ServerAliveCountMax=2 -o StrictHostKeyChecking=no mobile@$IP "$REMOTE_CMD" 2>/dev/null)
fi

# Output handling
if [ $? -eq 0 ]; then
    if [ ! -z "$RESPONSE" ]; then
        echo "$RESPONSE"
    fi
    exit 0
else
    echo "Error: Cannot connect to iPhone at $IP via SSH/Socket." >&2
    exit 1
fi
