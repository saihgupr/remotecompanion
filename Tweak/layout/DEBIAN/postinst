#!/bin/sh

# Set rc-root as setuid root
# This allows the mobile user to execute commands as root

# Check multiple possible locations for rc-root
RC_PATHS="/var/jb/usr/bin/rc-root /usr/bin/rc-root"

for RC_ROOT in $RC_PATHS; do
    if [ -f "$RC_ROOT" ]; then
        echo "Setting permissions for $RC_ROOT..."
        chown root:wheel "$RC_ROOT"
        chmod 4755 "$RC_ROOT"
    fi
done

# nfcd loads RCNFCReader when it starts: restart it (launchd starts it again at once)
killall -9 nfcd 2>/dev/null || /var/jb/usr/bin/killall -9 nfcd 2>/dev/null
# Same for companionfindlocallyd, which loads RCWatchPing
killall -9 companionfindlocallyd 2>/dev/null || /var/jb/usr/bin/killall -9 companionfindlocallyd 2>/dev/null
launchctl kickstart -p system/com.apple.companionfindlocallyd 2>/dev/null || true

exit 0
